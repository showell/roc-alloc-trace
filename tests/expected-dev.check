# The copy pairs (tests/CopyPairs.roc) in the dev build (--opt=dev), each
# run at 1,000 and 10,000 writes into a list of 1,000 entries, held to its
# allocations and reallocations a write. The dev build keeps a helper a
# call with an owned argument, so two shapes copy here that don't in the
# release build. Run from the repository's root, after tests/run.sh has
# built build/dev/copy-pairs.

small 1000
big 10000
slack 0.05
timeout 120
fail-if-printed overflowed

set-or-crash 0 0
  run build/dev/copy-pairs set-or-crash 1000 {N}
get-after-set 1 0 the old list read after its write: the write can't take it, so it copies
  run build/dev/copy-pairs get-after-set 1000 {N}
closure-called-before 0 0
  run build/dev/copy-pairs closure-called-before 1000 {N}
closure-called-after 1 0 a closure holding the old list called after the write
  run build/dev/copy-pairs closure-called-after 1000 {N}
helper-length-before-set 0 0
  run build/dev/copy-pairs helper-length-before-set 1000 {N}
helper-length-after-set 1 0 the helper reads its list after writing it, and the dev build keeps the helper a call
  run build/dev/copy-pairs helper-length-after-set 1000 {N}
str-list-or-crash 0 0
  run build/dev/copy-pairs str-list-or-crash 1000 {N}
str-list-restored 1 0 `?? xs` on a list of strings copies in the dev build
  run build/dev/copy-pairs str-list-restored 1000 {N}

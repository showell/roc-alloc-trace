# The copy pairs (tests/CopyPairs.roc) in the release build (--opt=speed),
# each run at 1,000 and 10,000 writes into a list of 1,000 entries, held to
# its allocations and reallocations a write. A copy is one allocation of
# the whole list a write. Run from the repository's root, after
# tests/run.sh has built build/release/copy-pairs.

small 1000
big 10000
slack 0.05
timeout 120
fail-if-printed overflowed

set-or-crash 0 0
  run build/release/copy-pairs set-or-crash 1000 {N}
get-after-set 1 0 the old list read after its write: the write can't take it, so it copies
  run build/release/copy-pairs get-after-set 1000 {N}
closure-called-before 0 0
  run build/release/copy-pairs closure-called-before 1000 {N}
closure-called-after 1 0 a closure holding the old list called after the write
  run build/release/copy-pairs closure-called-after 1000 {N}
helper-length-before-set 0 0
  run build/release/copy-pairs helper-length-before-set 1000 {N}
helper-length-after-set 0 0 the release build specializes the helper and writes in place
  run build/release/copy-pairs helper-length-after-set 1000 {N}
str-list-or-crash 0 0
  run build/release/copy-pairs str-list-or-crash 1000 {N}
str-list-restored 0 0 `?? xs` on a list of strings is free in the release build
  run build/release/copy-pairs str-list-restored 1000 {N}
